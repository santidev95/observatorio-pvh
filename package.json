{
  "name": "observatorio-porto-velho",
  "version": "0.3.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "wrangler dev --env-file=.env.local",
    "deploy": "opennextjs-cloudflare deploy -- --keep-vars",
    "deploy:check": "wrangler deploy --dry-run",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv --include-runtime=false --env-file=ops/postgres/types.env",
    "test": "tsx --test tests/*.test.ts",
    "sync": "tsx scripts/sync.ts",
    "sync:contracts": "tsx scripts/sync-contracts.ts",
    "sync:revenues": "tsx scripts/sync-revenues.ts",
    "data:export": "tsx scripts/export-supabase.ts",
    "db:setup": "tsx scripts/setup-postgres.ts",
    "db:seed": "tsx scripts/seed-postgres.ts",
    "db:local": "node scripts/local-db.mjs",
    "db:hyperdrive": "tsx scripts/configure-hyperdrive.ts",
    "probe": "node scripts/probe.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.10",
    "@supabase/supabase-js": "2.117.3",
    "cheerio": "1.2.0",
    "lucide-react": "0.468.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "patch-package": "8.0.1",
    "prettier": "3.9.10",
    "supabase": "2.120.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
